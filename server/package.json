{
  "name": "vobblix-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Realtime server for VobbLiX - a walk-around virtual card shop",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node scripts/migrate.js",
    "test:email": "node scripts/test-email.js",
    "test": "node --test 'test/unit/**/*.test.js'",
    "test:integration": "node --test --test-concurrency=1 'test/integration/**/*.test.js'",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.13",
    "pg": "^8.13.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.4"
  },
  "engines": {
    "node": ">=22"
  }
}
