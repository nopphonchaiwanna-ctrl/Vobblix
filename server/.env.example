# Copy this file to .env and fill in your own values. .env is gitignored.

# Any Postgres connection string. For a local install:
#   DATABASE_URL=postgres://localhost:5432/vobblix
# For a hosted free-tier Postgres (Neon, Supabase, Railway, etc.) use the
# connection string they give you - it usually already has ?sslmode=require.
DATABASE_URL=postgres://user:password@localhost:5432/vobblix

# Any long random string - used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

PORT=3001

# Where the CLIENT is deployed (no trailing slash) - used to build the
# links inside verification/password-reset emails, e.g.
# https://your-app.pages.dev. Defaults to the Vite dev server so this
# works out of the box locally.
CLIENT_URL=http://localhost:5173

# Production only (set NODE_ENV=production on the host). Browser origins
# allowed to call the API / open a socket, comma-separated, no trailing
# slash. Falls back to CLIENT_URL; with neither set the server refuses
# to start in production. In dev every origin is allowed.
#   CORS_ORIGINS=https://vobblix.pages.dev,https://www.example.com
NODE_ENV=
CORS_ORIGINS=
# Proxy hops in front of the server, so rate limits see the real client
# IP. Defaults to 1 in production (Render), 0 otherwise.
TRUST_PROXY=

# Integration tests only (npm run test:integration) - a SEPARATE local
# database whose name contains "test". Every run wipes it. Never point
# this at the real (Neon) database; the harness refuses if you do.
#   TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/vobblix_test
TEST_DATABASE_URL=

# SMTP creds for sending verification/password-reset emails (any
# provider works - Resend, SendGrid, Mailtrap for local testing, a
# personal Gmail account with an app password, ...). Leave unset for
# local dev and emails are just logged to the console instead of sent -
# see server/src/email.js.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=VobbLiX <no-reply@example.com>

# Powers lazy Thai translation of card skill text (see migrations/011,
# src/services/translateCardTh.js) - a card gets translated on-demand
# the first time its detail view is opened, then cached in the DB
# forever after. Leave unset and the card catalog still works fine -
# cards just serve without a Thai translation (skillTextTh comes back
# null). Uses Google's Gemini API free tier (no credit card needed) -
# get a free key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# Optional - defaults to "gemini-flash-lite-latest" in code if unset
# (switched from the plain flash alias after it kept 503ing under
# demand during testing while flash-lite didn't - see the comment in
# translateCardTh.js). Only set this if you want a different/pinned
# model version instead.
GEMINI_MODEL=
